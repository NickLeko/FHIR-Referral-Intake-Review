# Prefer: python scripts/setup_smart_sandbox.py && source .env.smart
# The generated ignored .env.smart contains a real test key and matching public
# registration. These placeholders alone are not usable credentials.
FHIR_AUTH_MODE=smart
FHIR_BASE_URL=https://launch.smarthealthit.org/v/r4/sim/REGISTRATION/fhir
FHIR_TOKEN_URL=https://launch.smarthealthit.org/v/r4/sim/REGISTRATION/auth/token
FHIR_CLIENT_ID=YOUR_REGISTERED_CLIENT_ID
FHIR_KEY_ID=YOUR_REGISTERED_RSA_KEY_ID
# Supply an actual multiline PEM through your environment/secret manager.
FHIR_PRIVATE_KEY_PEM=
# Optional; defaults to the seven input types' .rs scopes plus system/Task.crs.
# FHIR_SCOPES=...
